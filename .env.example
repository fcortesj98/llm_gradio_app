# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# --- watsonx.ai connection --------------------------------------------
# Required outside the IBM Skills Network lab environment.
WATSONX_APIKEY=
WATSONX_PROJECT_ID=skills-network
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- Models ------------------------------------------------------------
CHAT_MODEL_ID=meta-llama/llama-4-maverick-17b-128e-instruct-fp8
RAG_MODEL_ID=mistralai/mistral-medium-2505
EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual

# --- Generation --------------------------------------------------------
MAX_NEW_TOKENS=256
TEMPERATURE=0.5
EMBEDDING_TRUNCATE_INPUT_TOKENS=512

# --- Document chunking -------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=50

# --- Gradio server -----------------------------------------------------
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
